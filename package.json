{
  "name": "wherewasi",
  "version": "0.1.0",
  "description": "Save and restore your mental context across interruptions. Captures why you had those files open, not just which ones.",
  "keywords": [
    "cli",
    "context",
    "interruption",
    "focus",
    "git",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishuxz/wherewasi.git"
  },
  "homepage": "https://github.com/kishuxz/wherewasi#readme",
  "bugs": "https://github.com/kishuxz/wherewasi/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wherewasi": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
