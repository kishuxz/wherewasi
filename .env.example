# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing in this project loads .env automatically — there is no dotenv
# dependency and no config file, by design. Load it into your shell yourself:
#
#   set -a; source .env; set +a
#
# or per-command:
#
#   env $(grep -v '^#' .env | xargs) pnpm dev pause "note"

# Groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Anthropic. This is the key wherewasi actually uses today: `pause` calls
# claude-sonnet-4-6 to reconstruct the reasoning behind a captured state.
# Leave it unset and the tool still captures and stores everything; `resume`
# just prints the raw state instead.
ANTHROPIC_API_KEY=sk-ant-your_key_here
