# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing here loads .env automatically — there is no dotenv dependency and no
# config file, by design. Load it into your shell yourself:
#
#   set -a; source .env; set +a

# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Defaults shown; only the key is required.
# ---------------------------------------------------------------------------
WHEREWASI_API_KEY=
WHEREWASI_BASE_URL=https://api.groq.com/openai/v1
WHEREWASI_MODEL=openai/gpt-oss-120b

# Other vendors — same two variables, no code change:
#
#   OpenAI      WHEREWASI_BASE_URL=https://api.openai.com/v1
#   Together    WHEREWASI_BASE_URL=https://api.together.xyz/v1
#   OpenRouter  WHEREWASI_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek    WHEREWASI_BASE_URL=https://api.deepseek.com/v1
#
# Ollama — fully local, nothing leaves the machine, no key needed:
#
#   WHEREWASI_BASE_URL=http://localhost:11434/v1
#   WHEREWASI_MODEL=qwen2.5:7b
#
# Anthropic uses a different wire format and is selected automatically by its
# base URL, or explicitly with WHEREWASI_PROVIDER=anthropic:
#
#   WHEREWASI_BASE_URL=https://api.anthropic.com
#   WHEREWASI_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Legacy names, still honoured when the WHEREWASI_* vars are unset.
# ---------------------------------------------------------------------------
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
